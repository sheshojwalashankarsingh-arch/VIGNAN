# Copy this file to .env and fill in ONE of these. Leave all empty for offline mode.

# Google Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Groq — free key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Ollama — fully offline on your laptop (install from ollama.com, then `ollama pull llama3.2`)
# OLLAMA_MODEL=llama3.2
